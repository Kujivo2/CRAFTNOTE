rules_version = '2';

// Le navigateur ne parle JAMAIS a Firestore (7.2).
//
// Le modele de droits du 2 -- role, portee, surcharges individuelles, resolution en cascade --
// ne s'exprime pas raisonnablement en regles de securite : les y transposer produirait des
// regles illisibles et fausses. Toutes les lectures et toutes les ecritures passent donc par le
// code serveur avec l'Admin SDK, dans la couche data/, ou permission et portee sont controlees.
// L'Admin SDK contourne ces regles par conception : les fermer ne gene pas l'application.
//
// Le SDK client ne sert qu'a la connexion, qui touche Firebase Authentication et pas Firestore.
//
// Consequence assumee : pas de temps reel, un rechargement de page suffit partout.
// Ne pas ouvrir une exception "pour aller plus vite" sur un ecran isole.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
